{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "no-unused-vars": "error",
    "import/no-cycle": "error",
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/purity": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "data/**",
    "uploads/**"
  ]
}
